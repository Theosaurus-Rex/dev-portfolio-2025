---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectPreview from '@/components/ProjectPreview.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.order === undefined) return 1;
  if (b.data.order === undefined) return -1;
  return a.data.order - b.data.order;
});
---

<BaseLayout title="Projects" description="Portfolio of web development projects">
  <main class="flex flex-col bg-cream min-h-screen lg:px-24">
    <h1 class="font-climate-crisis text-orange uppercase font-bold text-4xl sm:text-6xl lg:text-8xl m-4 lg:my-8 lg:mx-0 text-outline-mobile md:text-outline-tablet lg:text-outline-desktop tracking-wider text-center">
      Projects
    </h1>

    <div class="m-4 lg:mx-0 mb-10 flex flex-col gap-8">
      {projects.map((project, index) => (
        <ProjectPreview project={project} index={index} />
      ))}
    </div>

    <!-- Note about adding more projects -->
    {projects.length === 0 && (
      <p class="text-center text-gray-600 mt-12">
        More projects coming soon!
      </p>
    )}
  </main>
</BaseLayout>
