---
import ZoomImage from '@/components/case-study/ZoomImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  desktop: ImageMetadata;
  desktopAlt: string;
  mobile: ImageMetadata;
  mobileAlt: string;
  caption?: string;
  desktopLabel?: string;
  mobileLabel?: string;
}

const {
  desktop,
  desktopAlt,
  mobile,
  mobileAlt,
  caption,
  desktopLabel = 'Desktop',
  mobileLabel = 'Mobile',
} = Astro.props;

const chip =
  'inline-block mb-2 uppercase font-kanit font-bold italic text-sm tracking-wider bg-black text-white rounded-md px-3 py-1';
---

<figure class="not-prose col-span-full w-full max-w-6xl mx-auto my-8">
  <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 items-start">
    <div>
      <span class={chip}>{desktopLabel}</span>
      <div class="border-4 border-black rounded-md overflow-hidden bg-white">
        <ZoomImage src={desktop} alt={desktopAlt} sizes="(min-width: 768px) 60vw, 100vw" />
      </div>
    </div>

    <div class="max-w-[240px] mx-auto md:max-w-none md:mx-0 md:w-[260px]">
      <span class={chip}>{mobileLabel}</span>
      <div class="border-4 border-black rounded-md overflow-hidden bg-white">
        <ZoomImage src={mobile} alt={mobileAlt} sizes="260px" />
      </div>
    </div>
  </div>
  {caption && (
    <figcaption class="font-kanit font-medium italic mt-2 text-base">
      {caption}
    </figcaption>
  )}
</figure>
