---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ContentCard from '@/components/ContentCard.astro';
import Pill from '@/components/Pill.astro';
import ButtonLink from '@/components/ButtonLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { name, description, image, imageAlt, githubUrl, liveUrl, caseStudy, status, tools } =
  project.data;

const colours = ['blue', 'pink', 'orange', 'purple', 'lime'] as const;
const colour = colours[index % colours.length];

const coverFrameClass =
  'block border-4 border-black rounded-md overflow-hidden bg-white aspect-16/10';
const coverLinkClass =
  'transition-transform hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#000] motion-reduce:transition-none motion-reduce:hover:translate-x-0 motion-reduce:hover:translate-y-0';
---

<ContentCard colour={colour} class="shadow-[8px_8px_0_0_var(--color-black)]">
  <div class="flex flex-col lg:flex-row gap-6 lg:items-center">
    <div class="lg:w-1/2 shrink-0">
      {caseStudy ? (
        <a
          href={`/projects/${project.id}`}
          aria-hidden="true"
          tabindex="-1"
          class:list={[coverFrameClass, coverLinkClass]}
        >
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="w-full h-full object-cover object-left-top"
          />
        </a>
      ) : (
        <div class={coverFrameClass}>
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="w-full h-full object-cover object-left-top"
          />
        </div>
      )}
    </div>

    <div>
      {(status || caseStudy) && (
        <div class="flex flex-wrap gap-2">
          {status && (
            <span class="uppercase font-kanit font-bold italic text-sm tracking-wider bg-black text-white rounded-md px-3 py-1">
              {status}
            </span>
          )}
          {caseStudy && (
            <span class="uppercase font-kanit font-bold italic text-sm tracking-wider bg-black text-white rounded-md px-3 py-1">
              Case study
            </span>
          )}
        </div>
      )}

      <h2 class="font-kanit text-3xl lg:text-4xl font-bold uppercase italic mt-3">
        {caseStudy ? (
          <a href={`/projects/${project.id}`} class="hover:underline underline-offset-4">
            {name}
          </a>
        ) : (
          name
        )}
      </h2>

      <p class="font-kanit font-medium md:text-lg mt-2">
        {description}
      </p>

      {tools && (
        <ul class="flex flex-wrap gap-1.5 mt-4">
          {tools.map((tool) => (
            <Pill text={tool} />
          ))}
        </ul>
      )}

      <div class="flex flex-wrap gap-3 mt-6">
        {caseStudy && (
          <ButtonLink href={`/projects/${project.id}`} colour="white">
            Read Case Study
          </ButtonLink>
        )}
        {liveUrl && (
          <ButtonLink href={liveUrl} colour="white" external>
            View Live
          </ButtonLink>
        )}
        <ButtonLink href={githubUrl} colour="white" external>
          View Code
        </ButtonLink>
      </div>
    </div>
  </div>
</ContentCard>
