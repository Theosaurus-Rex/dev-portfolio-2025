---
---

<dialog
  id="case-study-lightbox"
  class="m-auto w-[min(96vw,1600px)] max-h-[92vh] rounded-md border-4 border-black bg-cream p-0 backdrop:bg-black/80"
>
  <button
    type="button"
    data-lightbox-close
    autofocus
    class="absolute top-2 right-2 z-10 rounded-md bg-black px-3 py-2 font-kanit font-bold uppercase italic tracking-wider text-white focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-black"
  >
    Close
  </button>
  <div class="max-h-[92vh] overflow-auto p-4 pt-14">
    <img data-lightbox-image src="" alt="" class="mx-auto h-auto max-w-full" />
    <p
      data-lightbox-caption
      class="mt-2 hidden text-center font-kanit text-base font-medium italic"
    >
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#case-study-lightbox');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const caption = dialog?.querySelector<HTMLParagraphElement>('[data-lightbox-caption]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]');

  let lastFocused: HTMLElement | null = null;

  function openLightbox(link: HTMLAnchorElement) {
    if (!dialog || !image) return;

    image.src = link.href;
    image.alt = link.dataset.alt ?? '';

    const figcaption = link.closest('figure')?.querySelector('figcaption');
    if (caption) {
      caption.textContent = figcaption?.textContent ?? '';
      caption.classList.toggle('hidden', !figcaption);
    }

    lastFocused = link;
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
  }

  function closeLightbox() {
    dialog?.close();
  }

  links.forEach(link => {
    link.addEventListener('click', event => {
      event.preventDefault();
      openLightbox(link);
    });
  });

  closeButton?.addEventListener('click', closeLightbox);

  dialog?.addEventListener('click', event => {
    if (event.target === dialog) closeLightbox();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    if (image) image.src = '';
    lastFocused?.focus();
  });
</script>
