---
import ZoomImage from '@/components/case-study/ZoomImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: 'text' | 'wide';
  frame?: boolean;
  class?: string;
}

/*
  Tailwind scans source for complete class strings, so the width variants
  have to be spelled out rather than interpolated from the prop.
*/
const widthClasses = {
  text: '',
  wide: 'col-span-full w-full max-w-6xl mx-auto',
} as const;

const { src, alt, caption, width = 'wide', frame = true, class: className = '' } = Astro.props;
---

<figure class:list={['not-prose my-8', widthClasses[width], className]}>
  <div class:list={[frame && 'border-4 border-black rounded-md overflow-hidden bg-white']}>
    <ZoomImage src={src} alt={alt} sizes="(min-width: 1024px) 60vw, 100vw" />
  </div>
  {caption && (
    <figcaption class="font-kanit font-medium italic mt-2 text-base">
      {caption}
    </figcaption>
  )}
</figure>
