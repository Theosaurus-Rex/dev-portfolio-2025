---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, sizes, class: className = '', eager = false } = Astro.props;

const largeImage = await getImage({
  src,
  width: Math.min(2400, src.width),
  format: 'webp',
});
---

<a
  href={largeImage.src}
  data-lightbox
  data-alt={alt}
  class="group relative block cursor-zoom-in focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-black"
>
  <span class="sr-only">View full size: {alt}</span>
  <Image
    src={src}
    alt=""
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class:list={['w-full h-auto', className]}
  />
  <span
    aria-hidden="true"
    class="pointer-events-none absolute top-2 right-2 rounded-md bg-black px-2 py-1 font-kanit text-xs font-bold uppercase italic tracking-wider text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100"
  >
    ⤢ Zoom
  </span>
</a>
